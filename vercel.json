{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self'; connect-src 'self' https://formspree.io; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/performance/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "dard-capsule"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-dard-capsule-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "dard-oil"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-dard-oil-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "dard-oil"
        },
        {
          "type": "query",
          "key": "format",
          "value": "1"
        }
      ],
      "destination": "/_search/product-dard-oil-format-1.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "kabi-haran"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-kabi-haran-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "madhumeh-value"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-madhumeh-value-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "madhumeh-premium"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-madhumeh-premium-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "hriday-rakshak"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-hriday-rakshak-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "arshharan"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-arshharan-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "arshharan-capsules"
        },
        {
          "type": "query",
          "key": "format",
          "value": "0"
        }
      ],
      "destination": "/_search/product-arshharan-capsules-format-0.html"
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "(?<searchProduct>[a-z0-9-]+)"
        }
      ],
      "destination": "/_search/product-:searchProduct.html"
    },
    {
      "source": "/ingredients.html",
      "has": [
        {
          "type": "query",
          "key": "ingredient",
          "value": "(?<searchIngredient>[a-z0-9-]+)"
        }
      ],
      "destination": "/_search/ingredient-:searchIngredient.html"
    },
    {
      "source": "/product.html",
      "destination": "/_search/product-default.html"
    },
    {
      "source": "/ingredients.html",
      "destination": "/_search/ingredients-default.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "madhavmarketing.store"
        }
      ],
      "destination": "https://www.madhavmarketing.store/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "madhav-marketing.vercel.app"
        }
      ],
      "destination": "https://www.madhavmarketing.store/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
